<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - IssueForge</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/IssueForge.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg issueforge-navbar">

            <div class="container">

                <a class="navbar-brand issueforge-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-mark">
                        IF
                    </span>

                    <span>
                        IssueForge
                    </span>

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#issueForgeNavbar"
                        aria-controls="issueForgeNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div id="issueForgeNavbar"
                     class="navbar-collapse collapse">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="AdminDashboard"
                                       asp-action="Index">
                                        Dashboard
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="AdminDashboard"
                                       asp-action="AllTickets">
                                        All Tickets
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="AdminDashboard"
                                       asp-action="Users">
                                        Manage Users
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("SupportAgent"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="SupportAgent"
                                       asp-action="Index">
                                        Dashboard
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="SupportAgent"
                                       asp-action="Index">
                                        Assigned Tickets
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="UserDashboard"
                                       asp-action="Index">
                                        Dashboard
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Tickets"
                                       asp-action="Index">
                                        My Tickets
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Tickets"
                                       asp-action="Create">
                                        Create Ticket
                                    </a>
                                </li>
                            }
                        }

                    </ul>

                    <div class="navbar-account">
                        <partial name="_LoginPartial" />
                    </div>

                </div>

            </div>

        </nav>
    </header>

    <main class="page-content">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="issueforge-footer">

        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">

            <span>
                &copy; 2026 IssueForge
            </span>

            <div class="footer-links">

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Privacy">
                    Privacy
                </a>

                <span>
                    ASP.NET Core Support Platform
                </span>

            </div>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>