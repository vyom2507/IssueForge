@model IssueForge.Models.Ticket

@{
    ViewData["Title"] = "Ticket Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1>Ticket Details</h1>

        <p class="text-muted mb-0">
            Review the assigned support request.
        </p>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Dashboard
    </a>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        <h3 class="mb-4">
            @Model.Title
        </h3>

        <dl class="row">

            <dt class="col-sm-3">
                Ticket ID
            </dt>

            <dd class="col-sm-9">
                #@Model.Id
            </dd>

            <dt class="col-sm-3">
                Description
            </dt>

            <dd class="col-sm-9">
                @Model.Description
            </dd>

            <dt class="col-sm-3">
                Priority
            </dt>

            <dd class="col-sm-9">
                @Model.Priority
            </dd>

            <dt class="col-sm-3">
                Status
            </dt>

            <dd class="col-sm-9">
                @Model.Status
            </dd>

            <dt class="col-sm-3">
                Created
            </dt>

            <dd class="col-sm-9">
                @(Model.CreatedAt
                    .ToLocalTime()
                    .ToString("MMM dd, yyyy h:mm tt"))
            </dd>

            <dt class="col-sm-3">
                Last Updated
            </dt>

            <dd class="col-sm-9">

                @if (Model.UpdatedAt.HasValue)
                {
                    @(Model.UpdatedAt.Value
                        .ToLocalTime()
                        .ToString("MMM dd, yyyy h:mm tt"))
                }
                else
                {
                    <span class="text-muted">
                        Not updated yet
                    </span>
                }

            </dd>

            <dt class="col-sm-3">
                Due Date
            </dt>

            <dd class="col-sm-9">

                @if (Model.DueDate.HasValue)
                {
                    @(Model.DueDate.Value
                        .ToString("MMM dd, yyyy"))
                }
                else
                {
                    <span class="text-muted">
                        Not set
                    </span>
                }

            </dd>

        </dl>

    </div>
</div>