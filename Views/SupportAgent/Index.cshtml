@model IssueForge.Models.SupportAgentDashboardViewModel

@{
    ViewData["Title"] = "Support Agent Dashboard";
}

<div class="mb-4">
    <h1>Support Agent Dashboard</h1>

    <p class="text-muted">
        View and manage tickets assigned to you.
    </p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="row g-3 mb-4">

    <div class="col-md-6 col-xl">
        <div class="card dashboard-stat h-100">
            <div class="card-body">
                <span>Total Assigned</span>
                <h2>@Model.TotalAssignedTickets</h2>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl">
        <div class="card dashboard-stat h-100">
            <div class="card-body">
                <span>Assigned</span>
                <h2>@Model.AssignedTickets</h2>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl">
        <div class="card dashboard-stat h-100">
            <div class="card-body">
                <span>In Progress</span>
                <h2>@Model.InProgressTickets</h2>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl">
        <div class="card dashboard-stat h-100">
            <div class="card-body">
                <span>Resolved</span>
                <h2>@Model.ResolvedTickets</h2>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl">
        <div class="card dashboard-stat h-100">
            <div class="card-body">
                <span>Closed</span>
                <h2>@Model.ClosedTickets</h2>
            </div>
        </div>
    </div>

</div>

<div class="card">

    <div class="card-header bg-white">
        <h4 class="mb-0">
            My Assigned Tickets
        </h4>
    </div>

    <div class="card-body p-0">

        @if (!Model.Tickets.Any())
        {
            <div class="p-4">
                <div class="alert alert-info mb-0">
                    No tickets are currently assigned to you.
                </div>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Title</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Due Date</th>
                            <th>Update Status</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var ticket in Model.Tickets)
                        {
                            <tr>

                                <td>
                                    #@ticket.Id
                                </td>

                                <td>
                                    <strong>
                                        @ticket.Title
                                    </strong>
                                </td>

                                <td>
                                    <span class="ticket-badge priority-@ticket.Priority.ToString().ToLowerInvariant()">
                                        @ticket.Priority
                                    </span>
                                </td>

                                <td>
                                    <span class="ticket-badge status-@ticket.Status.ToString().ToLowerInvariant()">
                                        @(ticket.Status == IssueForge.Models.TicketStatus.InProgress
                                            ? "In Progress"
                                            : ticket.Status.ToString())
                                    </span>
                                </td>

                                <td>
                                    @(ticket.CreatedAt
                                        .ToLocalTime()
                                        .ToString("MMM dd, yyyy"))
                                </td>

                                <td>
                                    @if (ticket.DueDate.HasValue)
                                    {
                                        @(ticket.DueDate.Value.ToString("MMM dd, yyyy"))
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Not set
                                        </span>
                                    }
                                </td>

                                <td style="min-width: 245px;">

                                    <form asp-action="UpdateStatus"
                                          method="post"
                                          class="d-flex gap-2">

                                        <input type="hidden"
                                               name="ticketId"
                                               value="@ticket.Id" />

                                        <select name="status"
                                                class="form-select form-select-sm">

                                            <option value="Assigned"
                                                    selected="@(ticket.Status == IssueForge.Models.TicketStatus.Assigned)">
                                                Assigned
                                            </option>

                                            <option value="InProgress"
                                                    selected="@(ticket.Status == IssueForge.Models.TicketStatus.InProgress)">
                                                In Progress
                                            </option>

                                            <option value="Resolved"
                                                    selected="@(ticket.Status == IssueForge.Models.TicketStatus.Resolved)">
                                                Resolved
                                            </option>

                                            <option value="Closed"
                                                    selected="@(ticket.Status == IssueForge.Models.TicketStatus.Closed)">
                                                Closed
                                            </option>

                                        </select>

                                        <button type="submit"
                                                class="btn btn-sm btn-primary">
                                            Update
                                        </button>

                                    </form>

                                </td>

                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@ticket.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        Details
                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>