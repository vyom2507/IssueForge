@model IssueForge.Models.Ticket

@{
    ViewData["Title"] = "Create Ticket";
}

<h1>Create Ticket</h1>

<p class="text-muted">
    Submit a new support ticket.
</p>

<hr />

<div class="row">
    <div class="col-md-8 col-lg-6">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>

                <input asp-for="Title"
                       class="form-control" />

                <span asp-validation-for="Title"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Description"
                       class="form-label">
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="6">
                </textarea>

                <span asp-validation-for="Description"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Priority"
                       class="form-label">
                </label>

                <select asp-for="Priority"
                        asp-items="Html.GetEnumSelectList<IssueForge.Models.TicketPriority>()"
                        class="form-select">
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="DueDate"
                       class="form-label">
                </label>

                <input asp-for="DueDate"
                       type="date"
                       class="form-control" />
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Create Ticket
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}