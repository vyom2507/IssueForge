@model IssueForge.Models.Ticket

@{
    ViewData["Title"] = "Delete Ticket";
}

<h1>Delete Ticket</h1>

<div class="alert alert-danger">
    Are you sure you want to permanently delete this ticket?
</div>

<div class="card">
    <div class="card-body">

        <h4>
            @Model.Title
        </h4>

        <dl class="row mt-4">

            <dt class="col-sm-3">
                Priority
            </dt>

            <dd class="col-sm-9">
                @Model.Priority
            </dd>

            <dt class="col-sm-3">
                Status
            </dt>

            <dd class="col-sm-9">
                @Model.Status
            </dd>

            <dt class="col-sm-3">
                Created
            </dt>

            <dd class="col-sm-9">
                @Model.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
            </dd>

        </dl>

        <form asp-action="Delete"
              method="post">

            <input type="hidden"
                   asp-for="Id" />

            <button type="submit"
                    class="btn btn-danger">
                Delete Ticket
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>